<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>CarMecaSim.Mp</RootNamespace>
    <AssemblyName>CarMecaSim.Mp</AssemblyName>
    <Version>0.1.9</Version>
    <Product>CarMecaSim.Mp</Product>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\shared\CarMecaSim.Shared.csproj" />
    <PackageReference Include="Steamworks.NET" Version="20.2.0" />
  </ItemGroup>

  <!-- BepInEx 6 (IL2CPP) core + Il2CppInterop runtime + Harmony (present in game; not copied) -->
  <ItemGroup>
    <Reference Include="$(BepInExDir)\core\BepInEx.Core.dll"><Private>false</Private></Reference>
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll"><Private>false</Private></Reference>
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.Common.dll"><Private>false</Private></Reference>
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Runtime.dll"><Private>false</Private></Reference>
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Common.dll"><Private>false</Private></Reference>
    <Reference Include="$(BepInExDir)\core\0Harmony.dll"><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Generated interop assemblies EXCEPT the game's stripped Steamworks (clashes with Steamworks.NET) -->
  <ItemGroup>
    <Reference Include="$(BepInExDir)\interop\*.dll"
               Exclude="$(BepInExDir)\interop\com.rlabrecque.steamworks.net.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>










