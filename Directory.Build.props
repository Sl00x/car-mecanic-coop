<Project>
  <!-- Shared build settings. GameDir can be overridden: dotnet build -p:GameDir="..." -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Car Mechanic Simulator 2021</GameDir>
    <GameMLDir>$(GameDir)\MelonLoader</GameMLDir>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppStstVersion>0.1.0</AppStstVersion>
  </PropertyGroup>
</Project>
